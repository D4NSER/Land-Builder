<Project Sdk="Godot.NET.Sdk/4.6.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AssemblyName>LandBuilder.Presentation</AssemblyName>
    <RootNamespace>LandBuilder.Presentation</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/Presentation/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="src/LandBuilder.Core/LandBuilder.Core.csproj" />
  </ItemGroup>
</Project>
